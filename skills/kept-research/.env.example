# kept-research keys. Put them in the repo-root .env (~/coldoutboundskills/.env) or ~/.env —
# Eric's loadEnv() reads both. Never commit real values.

# Parallel.ai: Search API discovery (adaptive) + Task Group gap research (Eric's name PARALLEL_AI_API_KEY also works)
PARALLEL_API_KEY=
# Quick Enrich: contact finder is free, email lookup is 1 credit (uncapped — treated as unlimited)
QUICKENRICH_API_KEY=
# gpt-5-nano: Eric's ICP judge, plus this skill's search planner/extractor. Pinned to gpt-5-nano by kept-run.ts.
OPENAI_API_KEY=

# Instantly: used ONLY to add qualified leads to a lead list (never a campaign; nothing is sent)
INSTANTLY_API_KEY=

# Optional
# KEPT_MAX_USD=100   global per-run Parallel cap when the tab sets no budget. Quick Enrich has no cap.
